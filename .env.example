# Tulsi Jewellers — environment variables
# Copy to `.env.local` for development (never commit real keys).
# In Vercel: Project Settings → Environment Variables.
# In GitHub: Settings → Secrets and variables → Actions (for CRON_SECRET, SITE_URL).

# --- Supabase (Dashboard → Project Settings → API) --------------------------
# Public: inlined into the client bundle by Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_, never ship to
# the browser. Used only by src/lib/supabase/admin.ts (rate job, admin APIs).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Site -------------------------------------------------------------------
# Canonical origin for metadata/sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The showroom's own Google Maps locations (optional — the Visit page falls back
# to a keyless address search without them).
# 1. Google Maps → find the shop → Share → Copy link        → maps URL
# 2. Google Maps → Share → Embed a map → copy the iframe src → embed URL
# Paste them in Vercel → Settings → Environment Variables (Production AND
# Preview), then redeploy. No Google API key or billing account is involved.
NEXT_PUBLIC_GOOGLE_MAPS_URL=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# --- Automatic daily rates ---------------------------------------------------
# Nothing is required to start: with RATE_PROVIDER unset the site uses the
# key-less spot feed (api.gold-api.com), converts USD per troy ounce to INR with
# a daily reference FX rate, and derives 24K/22K/20K/18K/14K and silver 999.
# It runs once a day (Vercel Cron + GitHub Actions backup; on a laptop it also
# runs when the server starts and when the board is more than 6 hours old).
#
#   RATE_PROVIDER unset  → MetalCharts if RATE_API_KEY exists, else the key-less feed
#   RATE_PROVIDER=spot    → key-less feed, no key at all
#   RATE_PROVIDER=metalcharts + RATE_API_KEY=YOUR_KEY   (free plan, 200 calls/month)
#   RATE_PROVIDER=metalsdev   + METALS_DEV_API_KEY=…    (100 calls/month, INR direct)
#   RATE_PROVIDER=manual                                (owner enters the rate)
#
# A key set here is server-only: never logged, never in the bundle.
# RATE_API_KEY=
# Optional: pin the FX rate instead of using the daily reference (e.g. 94.96).
# RATE_USD_INR=
# Optional: a different JSON endpoint on the same host.
# RATE_API_URL=
#
# The market gap, stated by the showroom: international spot converted to INR is
# lower than what an Indian jeweller quotes (duty, local premium, taxes). Set
# this ONCE to the difference you see at your own counter and every value moves by
# that percentage, printed on the rates page as a shop-set adjustment. 0 = off.
# RATE_INDIAN_MARKET_PCT=0
#
# Local (no database) rate store, used until Supabase is configured. Values go to
# .data/rates.json, which is git-ignored. Set RATE_LOCAL_STORE=off to disable.
# RATE_LOCAL_STORE=
# RATE_STORE_DIR=.data

# --- rate safety rails -------------------------------------------------------
# Calls allowed per calendar month. The job stops at 90% of this, so the last 10%
# is never spent by a retry. MetalCharts free = 200; metals.dev free = 100.
# RATE_API_MONTHLY_LIMIT=200
# Hold a value for admin approval when it moves more than this percentage
# against the last published value for the same series.
# RATE_MAX_JUMP_PCT=5
# Refuse a provider timestamp older than this many days (and any future date).
# RATE_MAX_AGE_DAYS=7

# --- media sync (build-time only) -------------------------------------------
# Used ONLY by `npm run sync:media`, never at page view and never in the client
# bundle. Both libraries allow commercial use; Pexels asks for a visible credit.
# PEXELS_API_KEY=        https://www.pexels.com/api/
# PIXABAY_API_KEY=       https://pixabay.com/api/docs/

# --- scheduled job -----------------------------------------------------------
# The cron route REFUSES to run without this (HTTP 503), so it is never an open
# write path. Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
# GitHub Actions uses it as a repository secret. Set the same value in both.
# CRON_SECRET=
