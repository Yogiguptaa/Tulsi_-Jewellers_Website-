# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local enquiry fallback + scratch
.data/
.scratch/

# packaging output and the throwaway extraction used to verify the zip
/tulsi-jewellers-website.zip
/.verify/

# generated audit output — screenshots alone are ~480 MB and must not be pushed
/audit/screenshots/
/audit/report.json
/audit/report.focus.json
/audit/*.log
/audit/*.out.txt

# local dev server logs
*.next-dev.log
*.next-start.log
*.next-start-*.log
*.preview-dev.log

# local rate-diagnosis server log
.rate-fix-server.log
/freebuff-sites-build/
/.open-next/
/.wrangler/
# Generated by the Freebuff Sites build; recreated on every publish.
/freebuff.wrangler.jsonc
/freebuff.open-next.config.ts
# Screenshots taken while verifying the running site.
/screenshots/
# Local pointer to the Freebuff Sites project, not part of the app.
/.freebuff/

# Local-only: the generated CRON_SECRET for Vercel + GitHub.
.cron-secret.txt

# Local agent artefacts (never deployed, never committed)
.cloud-attachments/
.next-start.pid
